    { "src": "icons/calendar-app-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/calendar-app-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/calendar-app-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
